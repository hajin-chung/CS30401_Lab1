diff --git a/utils/verify-cubic-new-ecn.py b/utils/verify-cubic-new-ecn.py
new file mode 100644
index 0000000..5f6e7ab
--- /dev/null
+++ b/utils/verify-cubic-new-ecn.py
@@ -0,0 +1,363 @@
+#!/usr/bin/env python3
+"""Verify persistent per-flow ECN and ECE levels against ISL route snapshots.
+
+Usage:
+  python3 utils/verify-cubic-new-ecn.py /path/to/run
+  python3 utils/verify-cubic-new-ecn.py --regression /path/to/new/output
+
+The verifier independently reconstructs each active flow's ISL path from fstate
+updates. Every change must toggle ECN between ECT0 (2) and CE (3), including
+changes between packets. Every routed data packet must carry the current level;
+receiver ACKs must retain the last accepted data packet's ECE level, and sender
+ACK receptions must preserve the receiver's flags. NotECT/ECT1 data (including
+Classic ECN retransmissions) retains the receiver's previous feedback level.
+Packet UIDs identify actual
+packets, including retransmissions and duplicate cumulative ACKs.
+
+Regression inputs use four TLEs from the course constellation (override --state).
+They cover unchanged/reordered snapshots, unrelated changes, consecutive changes,
+restoration, downstream changes with unchanged ingress, removal of all ISL hops,
+multiple flows, sustained on/off phases, and changes during a data-free interval.
+The verifier writes logs_ns3/ecn-verification.csv with one row per flow phase.
+It does not require packets still in flight at simulation stop to be received.
+"""
+
+import argparse
+from bisect import bisect_right
+from collections import Counter, defaultdict
+import csv
+import os
+from pathlib import Path
+import subprocess
+
+
+def rows(path):
+    with path.open() as stream:
+        return list(csv.DictReader(stream))
+
+
+def read_config(run):
+    return dict(
+        line.strip().split("=", 1)
+        for line in (run / "config_ns3.properties").read_text().splitlines()
+        if line.strip() and not line.lstrip().startswith("#")
+    )
+
+
+def route(table, source, target):
+    path, visited = [], set()
+    while source != target:
+        if source in visited:
+            path.append((source, -1, -1, -1))
+            break
+        visited.add(source)
+        nxt, own_if, next_if = table[source, target]
+        path.append((source, nxt, own_if, next_if))
+        if nxt < 0 or own_if < 0:
+            break
+        source = nxt
+    return path
+
+
+def snapshots(directory, end, interval):
+    table = {}
+    for stamp in range(0, end, interval):
+        for line in (directory / f"fstate_{stamp}.txt").read_text().splitlines():
+            node, target, nxt, own_if, next_if = map(int, line.split(","))
+            table[node, target] = nxt, own_if, next_if
+        yield stamp, table
+
+
+def flow_key(row):
+    return tuple(row[c] for c in ("src_ip", "dst_ip", "src_port", "dst_port"))
+
+
+def socket_key(row):
+    return tuple(row[c] for c in ("local_ip", "peer_ip", "local_port", "peer_port"))
+
+
+def reverse(key):
+    src, dst, src_port, dst_port = key
+    return dst, src, dst_port, src_port
+
+
+def packet_key(row):
+    return tuple(row[c] for c in ("packet_uid", "seq", "payload"))
+
+
+def ack_key(row):
+    return tuple(row[c] for c in ("packet_uid", "seq", "ack", "payload", "flags"))
+
+
+def verify(run):
+    config = read_config(run)
+    logs = run / "logs_ns3"
+    assert (logs / "finished.txt").read_text().strip() == "Yes", "Run did not finish"
+    state = (run / config["satellite_network_dir"].strip('"')).resolve()
+    dynamic = (run / config["satellite_network_routes_dir"].strip('"')).resolve()
+    end = int(config["simulation_end_time_ns"])
+    interval = int(config["dynamic_state_update_interval_ns"])
+    state_end = 1 if config.get("satellite_network_force_static") == "true" else end
+    planes, per_plane = map(int, (state / "tles.txt").read_text().splitlines()[0].split())
+    num_sats = planes * per_plane
+    with (run / config["tcp_flow_schedule_filename"].strip('"')).open() as stream:
+        flows = [list(map(int, row[:5])) for row in csv.reader(stream)]
+    scheduled = Counter((f[1], f[2]) for f in flows)
+    routing = rows(logs / "isl-route-ecn.csv")
+    packets = [r for r in routing if r["event"] == "ecn_phase_packet"]
+    changes = [r for r in routing if r["event"] == "route_change"]
+    assert packets, "No per-packet ECN phase trace; build the persistent-toggle implementation"
+
+    first, pairs = {}, {}
+    for packet in packets:
+        key = flow_key(packet)
+        pair = int(packet["source"]), int(packet["target"])
+        assert pairs.setdefault(key, pair) == pair, f"Flow endpoints changed: {key}"
+        first.setdefault(key, int(packet["time_ns"]))
+        assert int(packet["payload"]) > 0, f"Non-data packet in phase trace: {packet}"
+    assert Counter(pairs.values()) == scheduled, "Some scheduled flows have no routed data"
+
+    previous, path_changes = {}, defaultdict(list)
+    for stamp, table in snapshots(dynamic, state_end, interval):
+        for source, target in scheduled:
+            # Include unreachable/loop sentinels as the implementation does.
+            isl = tuple(hop for hop in route(table, source, target)
+                        if hop[1] < 0 or (hop[0] < num_sats and hop[1] < num_sats))
+            pair = source, target
+            if pair in previous and previous[pair] != isl:
+                path_changes[pair].append(stamp)
+            previous[pair] = isl
+
+    phases, expected = {}, []
+    for key, pair in pairs.items():
+        levels = [(0, 2)]
+        for stamp in path_changes[pair]:
+            if stamp > first[key]:
+                level = 3 if levels[-1][1] == 2 else 2
+                levels.append((stamp, level))
+                expected.append((stamp, key, pair, level))
+        phases[key] = levels
+    actual = [(int(r["change_ns"]), flow_key(r),
+               (int(r["source"]), int(r["target"])), int(r["ecn"])) for r in changes]
+    assert Counter(actual) == Counter(expected), (
+        f"fstate toggles differ: expected {sorted(expected)}, got {sorted(actual)}")
+    assert all(r["time_ns"] == r["change_ns"] for r in changes), "Route toggles were deferred"
+
+    stats, sent_data = {}, defaultdict(list)
+    for key, levels in phases.items():
+        for index, (stamp, level) in enumerate(levels):
+            source, target = pairs[key]
+            stats[key, stamp] = {
+                "change_ns": stamp, "phase_end_ns": levels[index + 1][0]
+                if index + 1 < len(levels) else end,
+                "source": source, "target": target,
+                "src_ip": key[0], "dst_ip": key[1], "src_port": key[2], "dst_port": key[3],
+                "ecn": f"{level:02b}", "ece": int(level == 3),
+                "data_packets": 0, "received_packets": 0,
+                "acks_sent": 0, "acks_received": 0, "result": "PASS",
+            }
+    for index, packet in enumerate(packets):
+        key = flow_key(packet)
+        levels = phases[key]
+        phase_index = bisect_right([stamp for stamp, _ in levels], int(packet["time_ns"])) - 1
+        stamp, level = levels[phase_index]
+        assert (int(packet["change_ns"]), int(packet["ecn"])) == (stamp, level), (
+            f"Data packet did not retain route phase {(stamp, level)}: {packet}")
+        sent_data[key, packet_key(packet)].append((index, packet, (key, stamp)))
+        stats[key, stamp]["data_packets"] += 1
+
+    events = rows(logs / "tcp-ece.csv")
+    receiver_keys = {reverse(key): key for key in pairs}
+    received_data, last_phase, sent_acks = set(), {}, {}
+    sender_acks = 0
+    for event in events:
+        socket = socket_key(event)
+        kind = event["event"]
+        if kind == "ecn_data_received" and socket in receiver_keys:
+            if int(event["ecn"]) not in (2, 3):
+                # Classic ECN retransmissions may be NotECT and bypass marking.
+                # They do not change the receiver's persistent ECE phase.
+                continue
+            key = receiver_keys[socket]
+            candidates = [entry for entry in sent_data[key, packet_key(event)]
+                          if entry[0] not in received_data
+                          and int(entry[1]["time_ns"]) <= int(event["time_ns"])
+                          and entry[1]["ecn"] == event["ecn"]]
+            assert candidates, f"Received packet ECN differs from ground station phase: {event}"
+            index, _, phase = candidates[0]
+            received_data.add(index)
+            last_phase[socket] = phase
+            stats[phase]["received_packets"] += 1
+        elif kind == "ack_sent" and socket in receiver_keys:
+            assert int(event["flags"]) & 0x10 and not int(event["flags"]) & 0x02
+            key = receiver_keys[socket]
+            phase = last_phase.get(socket, (key, 0))
+            bit = int(bool(int(event["flags"]) & 0x40))
+            assert bit == stats[phase]["ece"], (
+                f"Receiver ACK lost persistent ECE level {stats[phase]['ece']}: {event}")
+            lookup = reverse(socket), ack_key(event)
+            assert lookup not in sent_acks, f"Duplicate sent ACK trace: {event}"
+            sent_acks[lookup] = event, phase
+            stats[phase]["acks_sent"] += 1
+        elif kind == "ack_received" and socket in pairs:
+            lookup = socket, ack_key(event)
+            assert lookup in sent_acks, f"Sender ACK differs from receiver's flags: {event}"
+            sent, phase = sent_acks[lookup]
+            assert int(event["time_ns"]) >= int(sent["time_ns"])
+            stats[phase]["acks_received"] += 1
+            sender_acks += 1
+
+    assert received_data, "No ECN phase data packets reached the receiver"
+    assert sender_acks, "No ECE level ACKs reached the sender"
+    for key in pairs:
+        assert sum(s["received_packets"] for (flow, _), s in stats.items() if flow == key), (
+            f"No data reached receiver for {key}")
+        assert sum(s["acks_received"] for (flow, _), s in stats.items() if flow == key), (
+            f"No feedback reached sender for {key}")
+    reports = list(stats.values())
+    with (logs / "ecn-verification.csv").open("w") as stream:
+        writer = csv.DictWriter(stream, fieldnames=list(reports[0]))
+        writer.writeheader()
+        writer.writerows(reports)
+    print(f"PASS {run.name}: {len(changes)} ISL toggles, {len(packets)} phase data packets, "
+          f"{len(received_data)} received packets, {sender_acks} matching ACKs at sender", flush=True)
+    return reports, packets
+
+
+def require_sustained(reports, changes=True):
+    levels = ("11", "10") if changes else ("10",)
+    for level in levels:
+        matching = [r for r in reports if r["ecn"] == level
+                    and (not changes or r["change_ns"] > 0)
+                    and all(r[field] >= 2 for field in
+                            ("data_packets", "received_packets", "acks_sent", "acks_received"))]
+        assert matching, f"No sustained ECN={level} phase with multiple data packets and echoed ACKs"
+
+
+def regression(output, state):
+    output.mkdir(parents=True, exist_ok=False)
+    # Use four satellites so boundary cases run quickly through the same loader.
+    mini = output / "state"
+    mini.mkdir()
+    tle_lines = (state / "tles.txt").read_text().splitlines()
+    (mini / "tles.txt").write_text("1 4\n" + "\n".join(tle_lines[1:13]) + "\n")
+    (mini / "ground_stations.txt").write_bytes((state / "ground_stations.txt").read_bytes())
+    links = [(0, 1), (0, 2), (1, 2), (1, 3), (2, 3)]
+    (mini / "isls.txt").write_text("".join(f"{a} {b}\n" for a, b in links))
+    (mini / "gsl_interfaces_info.txt").write_text("".join(f"{i},1,1.0\n" for i in range(6)))
+    interfaces, degree = {}, [0] * 4
+    for a, b in links:
+        interfaces[a, b], interfaces[b, a] = degree[a], degree[b]
+        degree[a] += 1
+        degree[b] += 1
+
+    def entry(node, nxt):
+        if node >= 4:
+            return nxt, 0, degree[nxt]
+        if nxt >= 4:
+            return nxt, degree[node], 0
+        return nxt, interfaces[node, nxt], interfaces[nxt, node]
+
+    def table_for(path):
+        table = {(node, dst): entry(node, 0 if dst == 4 else 3)
+                 for node in range(4) for dst in (4, 5) if node not in (0, 3)}
+        table.update({(0, 4): entry(0, 4), (0, 5): entry(0, 1),
+                      (3, 4): entry(3, 1), (3, 5): entry(3, 5)})
+        for sequence, dst in ((path, 5), (list(reversed(path)), 4)):
+            for node, nxt in zip(sequence, sequence[1:]):
+                table[node, dst] = entry(node, nxt)
+        return table
+
+    initial = table_for([4, 0, 1, 3, 5])
+    changed = table_for([4, 2, 1, 3, 5])
+    downstream = table_for([4, 0, 1, 2, 3, 5])
+    direct = table_for([4, 0, 5])
+    unrelated = initial.copy()
+    unrelated[2, 5] = entry(2, 1)
+    state = mini
+    bandwidth = "".join(f"{i},{degree[i] if i < 4 else 0},1.0\n" for i in range(6))
+
+    def run(name, updates, cc="TcpCubicNew", multiple=False, rate=10, end=4_000_000_000):
+        target = output / name
+        target.mkdir()
+        routes = target / "routes"
+        routes.mkdir()
+        current = initial
+        for stamp in range(0, end, 100_000_000):
+            previous = current
+            current = updates.get(stamp, current)
+            entries = sorted(current.items(), reverse=stamp >= 500_000_000)
+            # Updates after zero are deltas, including empty/reordered snapshots.
+            changed_entries = entries if stamp == 0 else [
+                (key, value) for key, value in entries if previous.get(key) != value]
+            if stamp and stamp % 500_000_000 == 0:
+                changed_entries = entries  # Repeating a snapshot must not toggle.
+            (routes / f"fstate_{stamp}.txt").write_text("".join(
+                f"{node},{dst},{nxt},{own},{remote}\n"
+                for (node, dst), (nxt, own, remote) in changed_entries))
+            (routes / f"gsl_if_bandwidth_{stamp}.txt").write_text(bandwidth)
+        (target / "config_ns3.properties").write_text(
+            f'simulation_end_time_ns={end}\nsimulation_seed=123456789\n'
+            f'satellite_network_dir="{os.path.relpath(state, target)}"\nsatellite_network_routes_dir="routes"\n'
+            f'dynamic_state_update_interval_ns=100000000\n'
+            f'isl_data_rate_megabit_per_s={rate}\ngsl_data_rate_megabit_per_s={rate}\n'
+            f'isl_max_queue_size_pkts=1000\ngsl_max_queue_size_pkts=1000\n'
+            f'enable_isl_utilization_tracking=false\ntcp_socket_type={cc}\n'
+            f'enable_tcp_flow_scheduler=true\ntcp_flow_schedule_filename="schedule.csv"\n')
+        schedule = "0,4,5,100000000000,0,,\n"
+        if multiple:
+            schedule += "1,4,5,100000000000,1000000,,\n2,5,4,100000000000,2000000,,\n"
+        (target / "schedule.csv").write_text(schedule)
+        ns3 = Path(__file__).resolve().parents[1]
+        with (target / "out.txt").open("w") as stream:
+            subprocess.run([str(ns3 / "ns3"), "run",
+                            f"main_satnet --run_dir={target}", "--no-build"],
+                           cwd=ns3, stdout=stream, stderr=subprocess.STDOUT, check=True)
+        if cc == "TcpCubicNew":
+            return verify(target)
+        assert (target / "logs_ns3/finished.txt").read_text().strip() == "Yes"
+        assert not (target / "logs_ns3/isl-route-ecn.csv").exists()
+        assert not (target / "logs_ns3/tcp-ece.csv").exists()
+        print(f"PASS {name}: ordinary TcpCubic run completed", flush=True)
+        return [], []
+
+    reports, _ = run("unchanged", {500_000_000: unrelated})
+    require_sustained(reports, changes=False)
+    run("consecutive-and-restored", {1_000_000_000: changed, 1_100_000_000: initial,
+                                     1_200_000_000: changed}, multiple=True)
+    for name, alternate in (("downstream", downstream), ("isl-removed-and-restored", direct)):
+        reports, _ = run(name, {1_000_000_000: alternate, 2_000_000_000: initial})
+        require_sustained(reports)
+    # Find two snapshot times strictly inside an actual packet-free interval.
+    # Low link rates create a gap after the initial window without altering TCP.
+    _, packets = run("idle-toggle-baseline", {}, rate=0.1, end=8_000_000_000)
+    times = sorted({int(p["time_ns"]) for p in packets})
+    candidates = [(left // 100_000_000 + 1) * 100_000_000 for left, right in zip(times, times[1:])
+                  if (left // 100_000_000 + 3) * 100_000_000 < right]
+    assert candidates, "No packet-free interval for consecutive-toggle regression"
+    stamp = candidates[0]
+    reports, packets = run("idle-consecutive-toggle", {stamp: changed, stamp + 100_000_000: initial},
+                           rate=0.1, end=8_000_000_000)
+    assert all(not stamp <= int(p["time_ns"]) < stamp + 200_000_000 for p in packets), (
+        "Traffic changed during selected idle interval")
+    assert any(r["change_ns"] == stamp and r["data_packets"] == 0 for r in reports)
+    assert any(r["change_ns"] == stamp + 100_000_000 and r["data_packets"] > 0
+               and r["ecn"] == "10" for r in reports), "Idle toggles did not preserve parity"
+    run("ordinary-cubic", {1_000_000_000: changed}, cc="TcpCubic")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--regression", action="store_true")
+    parser.add_argument("--state", type=Path,
+                        default=Path("/home/ubuntu/lab/data/seoul_london/state"))
+    args = parser.parse_args()
+    if args.regression:
+        regression(args.output.resolve(), args.state.resolve())
+    else:
+        verify(args.output.resolve())
+
+
+if __name__ == "__main__":
+    main()
