+void
+TcpSocketBase::WriteEcnCsv(const char* event,
+                           const TcpHeader& header,
+                           uint32_t payloadSize,
+                           uint8_t ecn,
+                           uint64_t packetUid)
+{
+    if (m_ecnTraceFile.empty())
+    {
+        return;
+    }
+    using Streams = std::map<std::string, std::unique_ptr<std::ofstream>>;
+    auto& stream = (*SimulationSingleton<Streams>::Get())[m_ecnTraceFile];
+    if (!stream)
+    {
+        stream = std::make_unique<std::ofstream>(m_ecnTraceFile);
+        NS_ABORT_MSG_IF(!*stream, "Cannot open ECN trace: " << m_ecnTraceFile);
+        *stream << "time_ns,event,node,local_ip,local_port,peer_ip,peer_port,seq,ack,payload,flags,ecn,packet_uid\n";
+    }
+    *stream << Simulator::Now().GetNanoSeconds() << ',' << event << ',' << m_node->GetId()
+            << ',';
+    if (m_endPoint)
+    {
+        *stream << m_endPoint->GetLocalAddress() << ',' << m_endPoint->GetLocalPort() << ','
+                << m_endPoint->GetPeerAddress() << ',' << m_endPoint->GetPeerPort();
+    }
+    else if (m_endPoint6)
+    {
+        *stream << m_endPoint6->GetLocalAddress() << ',' << m_endPoint6->GetLocalPort() << ','
+                << m_endPoint6->GetPeerAddress() << ',' << m_endPoint6->GetPeerPort();
+    }
+    *stream << ',' << header.GetSequenceNumber().GetValue() << ','
+            << header.GetAckNumber().GetValue() << ',' << payloadSize << ','
+            << static_cast<unsigned>(header.GetFlags()) << ',' << static_cast<unsigned>(ecn)
+            << ',' << packetUid << '\n';
+}
+
+bool
+TcpSocketBase::ProcessCubicNewEcn(const TcpHeader& header, uint32_t payloadSize, uint8_t ecn)
+{
+    if (m_congestionControl->GetName() != "TcpCubicNew")
+    {
+        return false;
+    }
+
+    // ACKs and control packets do not convey the forward data path's ECN level.
+    if (payloadSize == 0 || (header.GetFlags() & (TcpHeader::SYN | TcpHeader::RST)) ||
+        m_tcb->m_ecnState == TcpSocketState::ECN_DISABLED ||
+        (ecn != Ipv4Header::ECN_ECT0 && ecn != Ipv4Header::ECN_CE))
+    {
+        return true;
+    }
+
+    bool ece = ecn == Ipv4Header::ECN_CE;
+    if (ece != m_cubicNewEce)
+    {
+        // Preserve feedback for data already waiting for a delayed ACK before
+        // acknowledging data from the new path phase.
+        if (m_delAckEvent.IsPending())
+        {
+            SendEmptyPacket(TcpHeader::ACK);
+        }
+        m_cubicNewEce = ece;
+        m_cubicNewEcnTransitionPending = true;
+    }
+
+    if (ece)
+    {
+        m_ecnCESeq = std::max(m_ecnCESeq.Get(), header.GetSequenceNumber());
+    }
+    m_congestionControl->CwndEvent(m_tcb,
+                                   ece ? TcpSocketState::CA_EVENT_ECN_IS_CE
+                                       : TcpSocketState::CA_EVENT_ECN_NO_CE);
+    return true;
+}
+
+uint8_t
+TcpSocketBase::AddCubicNewEcnFeedback(uint8_t flags) const
+{
+    if (m_congestionControl->GetName() == "TcpCubicNew" && (flags & TcpHeader::ACK) &&
+        !(flags & TcpHeader::SYN) && m_tcb->m_ecnState != TcpSocketState::ECN_DISABLED)
+    {
+        flags &= ~TcpHeader::ECE;
+        if (m_cubicNewEce)
+        {
+            flags |= TcpHeader::ECE;
+        }
+    }
+    return flags;
+}
