+ArbiterSingleForwardHelper::IslPath
+ArbiterSingleForwardHelper::GetIslPath(uint32_t source, uint32_t target) const
+{
+    IslPath path;
+    std::set<uint32_t> visited;
+    uint32_t current = source;
+    while (current != target) {
+        if (!visited.insert(current).second) {
+            path.emplace_back(current, -1, -1, -1); // Routing loop
+            return path;
+        }
+        const auto [next, ownIf, nextIf] = m_arbiters.at(current)->GetSingleForwardState(target);
+        if (next < 0 || ownIf < 0) {
+            path.emplace_back(current, next, ownIf, nextIf); // Unreachable path
+            return path;
+        }
+        if (m_nodes.Get(current)->GetObject<Ipv4>()->GetNetDevice(ownIf)
+                ->GetObject<PointToPointLaserNetDevice>()) {
+            path.emplace_back(current, next, ownIf, nextIf);
+        }
+        current = next;
+    }
+    return path;
+}
+
+void
+ArbiterSingleForwardHelper::DetectIslRouteChanges(int64_t timestampNs)
+{
+    for (auto& [key, flow] : m_flowRoutes) {
+        auto path = GetIslPath(flow.source, flow.target);
+        if (path != flow.path) {
+            flow.path = std::move(path);
+            // Every actual path change flips the level, even between data packets.
+            flow.ce = !flow.ce;
+            flow.changeNs = timestampNs;
+            if (m_routeEcnCsv) {
+                const auto [src, dst, srcPort, dstPort] = key;
+                m_routeEcnCsv << Simulator::Now().GetNanoSeconds() << ",route_change," << timestampNs
+                             << ',' << flow.source << ',' << flow.target << ',' << Ipv4Address(src)
+                             << ',' << Ipv4Address(dst) << ',' << srcPort << ',' << dstPort
+                             << ",0,0," << (flow.ce ? 3 : 2) << ",0\n";
+            }
+        }
+    }
+}
+
+Ipv4Header::EcnType
+ArbiterSingleForwardHelper::GetIslRouteEcn(const Ipv4Header& ipHeader,
+                                        const TcpHeader& tcpHeader,
+                                        uint32_t payloadSize,
+                                        uint64_t packetUid)
+{
+    FlowKey key{ipHeader.GetSource().Get(), ipHeader.GetDestination().Get(),
+                tcpHeader.GetSourcePort(), tcpHeader.GetDestinationPort()};
+    auto it = m_flowRoutes.find(key);
+    if (it == m_flowRoutes.end()) {
+        auto arbiter = m_arbiters.front();
+        const uint32_t source = arbiter->ResolveNodeIdFromIp(ipHeader.GetSource().Get());
+        const uint32_t target = arbiter->ResolveNodeIdFromIp(ipHeader.GetDestination().Get());
+        // A newly observed flow starts with the current route as its baseline.
+        it = m_flowRoutes.emplace(key, FlowRoute{source, target, GetIslPath(source, target)}).first;
+    }
+    auto& flow = it->second;
+    const auto ecn = flow.ce ? Ipv4Header::ECN_CE : Ipv4Header::ECN_ECT0;
+    if (m_routeEcnCsv) {
+        m_routeEcnCsv << Simulator::Now().GetNanoSeconds() << ",ecn_phase_packet," << flow.changeNs
+                     << ',' << flow.source << ',' << flow.target << ',' << ipHeader.GetSource()
+                     << ',' << ipHeader.GetDestination() << ',' << tcpHeader.GetSourcePort()
+                     << ',' << tcpHeader.GetDestinationPort() << ','
+                     << tcpHeader.GetSequenceNumber().GetValue() << ',' << payloadSize << ','
+                     << static_cast<uint32_t>(ecn) << ',' << packetUid << '\n';
+    }
+    return ecn;
+}
+
 } // namespace ns3
