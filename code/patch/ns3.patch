+#include <algorithm>
+#include <cmath>
+#include <filesystem>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+
+namespace ns3 {
+LinkScenarioHelper* LinkScenarioHelper::m_active = nullptr;
+namespace {
+// Packet tags are simulator metadata: endpoint context does not consume link bandwidth.
+class ScenarioHopTag : public Tag {
+public:
+    uint32_t sender = 0, device = 0;
+    static TypeId GetTypeId() {
+        static TypeId tid = TypeId("ns3::ScenarioHopTag").SetParent<Tag>().AddConstructor<ScenarioHopTag>();
+        return tid;
+    }
+    TypeId GetInstanceTypeId() const override { return GetTypeId(); }
+    uint32_t GetSerializedSize() const override { return 8; }
+    void Serialize(TagBuffer b) const override { b.WriteU32(sender); b.WriteU32(device); }
+    void Deserialize(TagBuffer b) override { sender = b.ReadU32(); device = b.ReadU32(); }
+    void Print(std::ostream& out) const override { out << sender << ':' << device; }
+};
+std::string Trim(const std::string& s) {
+    auto first = s.find_first_not_of(" \t\r\n");
+    return first == std::string::npos ? "" : s.substr(first, s.find_last_not_of(" \t\r\n") - first + 1);
+}
+std::vector<std::string> Fields(const std::string& line) {
+    std::vector<std::string> result;
+    std::stringstream stream(line);
+    std::string field;
+    while (std::getline(stream, field, ',')) result.push_back(Trim(field));
+    return result;
+}
+double Number(const std::string& s) {
+    size_t end;
+    double value = std::stod(s, &end);
+    if (end != s.size() || !std::isfinite(value) || value < 0) throw std::runtime_error("Invalid nonnegative number: " + s);
+    return value;
+}
+uint32_t NodeId(const std::string& s, uint32_t count) {
+    double value = Number(s);
+    if (value >= count || value != std::floor(value)) throw std::runtime_error("Invalid node id: " + s);
+    return static_cast<uint32_t>(value);
+}
+std::string Resolve(Ptr<BasicSimulation> sim, const std::string& path) {
+    auto p = std::filesystem::path(path);
+    return (p.is_absolute() ? p : std::filesystem::path(sim->GetRunDir()) / p).string();
+}
+DataRate Rate(Ptr<NetDevice> device) {
+    if (auto gsl = DynamicCast<GSLNetDevice>(device)) return gsl->GetEffectiveDataRate();
+    return DynamicCast<PointToPointLaserNetDevice>(device)->GetEffectiveDataRate();
+}
+}
+
+LinkScenarioHelper::LinkScenarioHelper(Ptr<BasicSimulation> sim, Ptr<TopologySatelliteNetwork> topology)
+    : m_simulation(sim), m_topology(topology) {
+    auto capacity = sim->GetConfigParamOrDefault("link_congestion_scenario_file", "");
+    auto loss = sim->GetConfigParamOrDefault("link_loss_scenario_file", "");
+    double interval = Number(sim->GetConfigParamOrDefault("link_scenario_log_interval_ms", "10"));
+    if (interval <= 0 || interval > 1000) throw std::runtime_error("Log interval must be in (0,1000] ms");
+    m_interval = NanoSeconds(std::llround(interval * 1e6));
+    if (m_interval.IsZero()) throw std::runtime_error("Log interval is below 1 ns");
+    if (!capacity.empty()) {
+        m_capacityLog.open(sim->GetLogsDir() + "/scenario_capacity.csv");
+        m_queueLog.open(sim->GetLogsDir() + "/scenario_queues.csv");
+        m_dropLog.open(sim->GetLogsDir() + "/scenario_queue_drops.csv");
+        m_capacityLog << "time_ns,node,device,cap_bps,effective_bps\n";
+        m_queueLog << "time_ns,node,device,packets,bytes,effective_bps\n";
+        m_dropLog << "time_ns,node,device,bytes\n";
+        ReadCapacity(Resolve(sim, capacity));
+    }
+    if (!loss.empty()) {
+        ReadLossSchedule(Resolve(sim, loss));
+        m_lossLog.open(sim->GetLogsDir() + "/scenario_link_loss.csv");
+        m_lossDropLog.open(sim->GetLogsDir() + "/scenario_link_drops.csv");
+        m_lossLog << "start_ns,end_ns,src,dst,attempts,drops,peak_attempts,expected_drops\n";
+        m_lossDropLog << "time_ns,src,dst,bytes,probability,peak\n";
+        m_lossLog << std::setprecision(17);
+        m_lossDropLog << std::setprecision(17);
+        if (m_active) throw std::runtime_error("Only one link scenario per simulation is supported");
+        m_active = this;
+    }
+    // Time-zero caps must take effect before the first occupancy/rate sample.
+    if (!capacity.empty() || m_active == this) Simulator::ScheduleNow(&LinkScenarioHelper::Sample, this, true);
+}
+
+LinkScenarioHelper::~LinkScenarioHelper() {
+    if (m_active == this) m_active = nullptr;
+}
+
+void LinkScenarioHelper::ReadLossSchedule(const std::string& path) {
+    std::ifstream stream(path);
+    if (!stream) throw std::runtime_error("Cannot read loss scenario: " + path);
+    bool haveBase = false;
+    std::string line;
+    while (std::getline(stream, line)) {
+        line = Trim(line.substr(0, line.find('#')));
+        if (line.empty()) continue;
+        if (!haveBase) {
+            auto equals = line.find('=');
+            if (equals != std::string::npos) {
+                if (Trim(line.substr(0, equals)) != "base_loss_rate") throw std::runtime_error("Expected base_loss_rate");
+                line = Trim(line.substr(equals + 1));
+            }
+            m_baseLoss = Number(line);
+            if (m_baseLoss > 1) throw std::runtime_error("Base loss rate must be in [0,1]");
+            haveBase = true;
+            continue;
+        }
+        auto f = Fields(line);
+        if (f.size() != 6 || line.back() == ',') throw std::runtime_error("Expected node,type,peer,start_s,end_s,loss_rate");
+        double start = Number(f[3]), end = Number(f[4]), rate = Number(f[5]);
+        if (start >= end || end > m_simulation->GetSimulationEndTimeNs() / 1e9 || rate > 1)
+            throw std::runtime_error("Invalid loss interval/rate: " + line);
+        auto startNs = std::llround(start * 1e9), endNs = std::llround(end * 1e9);
+        if (startNs >= endNs) throw std::runtime_error("Loss interval must be at least 1 ns long");
+        for (auto device : SelectInterfaces(f))
+            m_lossSchedule[{device->GetNode()->GetId(), device->GetIfIndex()}].push_back({startNs, endNs, rate});
+    }
+    if (!haveBase) throw std::runtime_error("Loss scenario requires a base loss rate");
+    for (auto& [key, events] : m_lossSchedule) {
+        std::sort(events.begin(), events.end(), [](const LossInterval& a, const LossInterval& b) { return a.start < b.start; });
+        for (size_t i = 1; i < events.size(); ++i)
+            if (events[i].start < events[i - 1].end) throw std::runtime_error("Overlapping loss intervals on the same interface");
+    }
+}
+
+Ptr<Packet> LinkScenarioHelper::CopyForReceive(Ptr<const Packet> packet, Ptr<NetDevice> sender) {
+    auto copy = packet->Copy();
+    if (m_active) {
+        ScenarioHopTag tag;
+        copy->RemovePacketTag(tag);
+        tag.sender = sender->GetNode()->GetId();
+        tag.device = sender->GetIfIndex();
+        copy->AddPacketTag(tag);
+    }
+    return copy;
+}
+
+bool LinkScenarioHelper::ShouldDrop(uint32_t receiver, Ptr<Packet> packet) {
+    if (!m_active) return false;
+    auto& self = *m_active;
+    ScenarioHopTag tag;
+    if (!packet->RemovePacketTag(tag)) throw std::runtime_error("Missing link scenario packet context");
+    int64_t now = Simulator::Now().GetNanoSeconds();
+    // Only listed outgoing interfaces receive base loss. Evaluate windows at reception,
+    // using the original sender interface even if a route changed while in flight.
+    bool peak = false;
+    double p = 0;
+    auto target = self.m_lossSchedule.find({tag.sender, tag.device});
+    if (target != self.m_lossSchedule.end()) {
+        const auto& events = target->second;
+        auto it = std::upper_bound(events.begin(), events.end(), now,
+                                  [](int64_t t, const LossInterval& event) { return t < event.start; });
+        peak = it != events.begin() && now < std::prev(it)->end;
+        p = peak ? std::prev(it)->rate : self.m_baseLoss;
+    }
+    auto& count = self.m_lossCounts[{tag.sender, receiver}];
+    ++count.attempts;
+    count.peakAttempts += peak;
+    count.expected += p;
+    bool drop = p == 1;
+    if (p > 0 && p < 1) {
+        if (!count.random) {
+            count.random = CreateObject<UniformRandomVariable>();
+            // Independent directed-link streams; TCP arrival order cannot shift other links' draws.
+            count.random->SetStream(1000000 + int64_t(tag.sender) * self.m_topology->GetNumNodes() + receiver);
+        }
+        drop = count.random->GetValue() < p;
+    }
+    if (drop) {
+        ++count.drops;
+        self.m_lossDropLog << now << ',' << tag.sender << ',' << receiver << ',' << packet->GetSize() << ',' << p << ',' << peak << '\n';
+    }
+    return drop;
+}
+
+std::vector<Ptr<NetDevice>> LinkScenarioHelper::SelectInterfaces(const std::vector<std::string>& f) {
+    uint32_t node = NodeId(f[0], m_topology->GetNumNodes());
+    if (f[1] != "isl" && f[1] != "gsl") throw std::runtime_error("Link type must be isl or gsl");
+    if (f[1] == "gsl" && f[2] != "*") throw std::runtime_error("GSL scenarios apply to whole interfaces; use peer *");
+    int64_t peer = f[2] == "*" ? -1 : static_cast<int64_t>(NodeId(f[2], m_topology->GetNumNodes()));
+    auto n = m_topology->GetNodes().Get(node);
+    std::vector<Ptr<NetDevice>> matches;
+    for (uint32_t d = 0; d < n->GetNDevices(); ++d) {
+        auto device = n->GetDevice(d);
+        if ((f[1] == "gsl" && !DynamicCast<GSLNetDevice>(device)) ||
+            (f[1] == "isl" && !DynamicCast<PointToPointLaserNetDevice>(device))) continue;
+        if (peer >= 0) {
+            auto channel = device->GetChannel();
+            bool found = false;
+            for (size_t j = 0; j < channel->GetNDevices(); ++j)
+                if (channel->GetDevice(j) != device && channel->GetDevice(j)->GetNode()->GetId() == static_cast<uint32_t>(peer)) found = true;
+            if (!found) continue;
+        }
+        matches.push_back(device);
+    }
+    if (matches.empty()) throw std::runtime_error("No interfaces match: " + f[0] + "," + f[1] + "," + f[2]);
+    return matches;
+}
+
+void LinkScenarioHelper::ReadCapacity(const std::string& path) {
+    std::ifstream stream(path);
+    if (!stream) throw std::runtime_error("Cannot read congestion scenario: " + path);
+    std::string line;
+    while (std::getline(stream, line)) {
+        line = Trim(line);
+        if (line.empty() || line[0] == '#') continue;
+        auto f = Fields(line);
+        if (f.size() != 6) throw std::runtime_error("Expected node,type,peer,start_s,end_s,mbps: " + line);
+        uint32_t node = NodeId(f[0], m_topology->GetNumNodes());
+        double start = Number(f[3]), end = Number(f[4]), mbps = Number(f[5]);
+        if (start >= end || end > m_simulation->GetSimulationEndTimeNs() / 1e9 || mbps <= 0 || mbps > 1e6)
+            throw std::runtime_error("Invalid capacity interval/rate: " + line);
+        auto startNs = std::llround(start * 1e9), endNs = std::llround(end * 1e9);
+        uint64_t rate = std::llround(mbps * 1e6);
+        if (!rate || startNs >= endNs) throw std::runtime_error("Capacity interval/rate below simulator resolution");
+        for (auto device : SelectInterfaces(f)) {
+            uint32_t d = device->GetIfIndex();
+            auto gsl = DynamicCast<GSLNetDevice>(device);
+            auto isl = DynamicCast<PointToPointLaserNetDevice>(device);
+            auto key = std::make_pair(node, d);
+            if (!m_targets.count(key)) {
+                auto queue = gsl ? gsl->GetQueue() : isl->GetQueue();
+                m_targets.emplace(key, Target{device, queue, {}});
+                queue->TraceConnectWithoutContext("Drop", MakeBoundCallback(&LinkScenarioHelper::QueueDrop, this, node, d));
+            }
+            Simulator::Schedule(NanoSeconds(startNs), &LinkScenarioHelper::ChangeCap, this, node, d, rate, true);
+            Simulator::Schedule(NanoSeconds(endNs), &LinkScenarioHelper::ChangeCap, this, node, d, rate, false);
+        }
+    }
+}
+
+void LinkScenarioHelper::ChangeCap(uint32_t node, uint32_t d, uint64_t rate, bool start) {
+    auto& target = m_targets.at({node, d});
+    if (start) target.caps.insert(rate);
+    else target.caps.erase(target.caps.find(rate));
+    DataRate cap(target.caps.empty() ? 0 : *target.caps.begin());
+    if (auto gsl = DynamicCast<GSLNetDevice>(target.device)) gsl->SetScenarioRateCap(cap);
+    else DynamicCast<PointToPointLaserNetDevice>(target.device)->SetScenarioRateCap(cap);
+    m_capacityLog << Simulator::Now().GetNanoSeconds() << ',' << node << ',' << d << ','
+                  << cap.GetBitRate() << ',' << Rate(target.device).GetBitRate() << '\n';
+}
+
+void LinkScenarioHelper::QueueDrop(LinkScenarioHelper* self, uint32_t node, uint32_t device, Ptr<const Packet> packet) {
+    self->m_dropLog << Simulator::Now().GetNanoSeconds() << ',' << node << ',' << device << ',' << packet->GetSize() << '\n';
+}
+
+void LinkScenarioHelper::Sample(bool again) {
+    for (auto& [key, target] : m_targets) {
+        m_queueLog << Simulator::Now().GetNanoSeconds() << ',' << key.first << ',' << key.second << ','
+                   << target.queue->GetNPackets() << ',' << target.queue->GetNBytes() << ',' << Rate(target.device).GetBitRate() << '\n';
+    }
+    int64_t now = Simulator::Now().GetNanoSeconds();
+    for (auto& [key, count] : m_lossCounts) {
+        if (count.attempts) {
+            m_lossLog << m_lastSample << ',' << now << ',' << key.first << ',' << key.second << ','
+                      << count.attempts << ',' << count.drops << ',' << count.peakAttempts << ',' << count.expected << '\n';
+            count.attempts = count.drops = count.peakAttempts = 0;
+            count.expected = 0;
+        }
+    }
+    m_lastSample = now;
+    if (again && Simulator::Now() + m_interval < NanoSeconds(m_simulation->GetSimulationEndTimeNs()))
+        Simulator::Schedule(m_interval, &LinkScenarioHelper::Sample, this, true);
+}
+
+void LinkScenarioHelper::Finish() {
+    if (!m_targets.empty() || m_active == this) Sample(false);
+    m_capacityLog.flush(); m_queueLog.flush(); m_dropLog.flush();
+    m_lossLog.flush(); m_lossDropLog.flush();
+}
+}
