+#ifndef LINK_SCENARIO_HELPER_H
+#define LINK_SCENARIO_HELPER_H
+
+#include "ns3/basic-simulation.h"
+#include "ns3/topology-satellite-network.h"
+#include "ns3/random-variable-stream.h"
+#include <fstream>
+#include <map>
+#include <set>
+#include <vector>
+
+namespace ns3 {
+
+class LinkScenarioHelper {
+public:
+    LinkScenarioHelper(Ptr<BasicSimulation> simulation, Ptr<TopologySatelliteNetwork> topology);
+    ~LinkScenarioHelper();
+    void Finish();
+    static Ptr<Packet> CopyForReceive(Ptr<const Packet> packet, Ptr<NetDevice> sender);
+    static bool ShouldDrop(uint32_t receiver, Ptr<Packet> packet);
+
+private:
+    struct Target {
+        Ptr<NetDevice> device;
+        Ptr<Queue<Packet>> queue;
+        std::multiset<uint64_t> caps;
+    };
+    Ptr<BasicSimulation> m_simulation;
+    Ptr<TopologySatelliteNetwork> m_topology;
+    std::map<std::pair<uint32_t, uint32_t>, Target> m_targets;
+    Time m_interval;
+    std::ofstream m_capacityLog, m_queueLog, m_dropLog;
+    static LinkScenarioHelper* m_active;
+    struct LossCount {
+        uint64_t attempts = 0, drops = 0, peakAttempts = 0;
+        double expected = 0;
+        Ptr<UniformRandomVariable> random;
+    };
+    std::map<std::pair<uint32_t, uint32_t>, LossCount> m_lossCounts;
+    struct LossInterval { int64_t start, end; double rate; };
+    std::map<std::pair<uint32_t, uint32_t>, std::vector<LossInterval>> m_lossSchedule;
+    double m_baseLoss = 0;
+    int64_t m_lastSample = 0;
+    std::ofstream m_lossLog, m_lossDropLog;
+    void ReadLossSchedule(const std::string& path);
+    std::vector<Ptr<NetDevice>> SelectInterfaces(const std::vector<std::string>& fields);
+    void ReadCapacity(const std::string& path);
+    void ChangeCap(uint32_t node, uint32_t device, uint64_t rate, bool start);
+    void Sample(bool again);
+    static void QueueDrop(LinkScenarioHelper* self, uint32_t node, uint32_t device, Ptr<const Packet> packet);
+};
+}
+#endif
