+                     uint8_t ecn,
+                     uint64_t packetUid);
+
+    /**
+     * Update the persistent receiver feedback for TcpCubicNew data.
+     *
+     * @param header TCP header of the received segment
+     * @param payloadSize TCP payload size in bytes
+     * @param ecn IP ECN code point
+     * @return True when TcpCubicNew handles the ECN feedback
+     */
+    bool ProcessCubicNewEcn(const TcpHeader& header, uint32_t payloadSize, uint8_t ecn);
+
+    /**
+     * Apply the persistent TcpCubicNew receiver ECE level to outgoing ACKs.
+     *
+     * @param flags Outgoing TCP flags
+     * @return TCP flags with the receiver feedback applied
+     */
+    uint8_t AddCubicNewEcnFeedback(uint8_t flags) const;
     Callback<void, Ipv4Address, uint8_t, uint8_t, uint8_t, uint32_t>
         m_icmpCallback; //!< ICMP callback
     Callback<void, Ipv6Address, uint8_t, uint8_t, uint8_t, uint32_t>
@@ -1510,6 +1543,8 @@ class TcpSocketBase : public TcpSocket
     TracedValue<SequenceNumber32> m_ecnCESeq{
         0}; //!< Sequence number of the last received Congestion Experienced
     TracedValue<SequenceNumber32> m_ecnCWRSeq{0}; //!< Sequence number of the last sent CWR
+    bool m_cubicNewEce{false}; ///< Receiver ECE level from the latest TcpCubicNew data ECN
+    bool m_cubicNewEcnTransitionPending{false}; ///< Send an immediate ACK after a feedback transition
